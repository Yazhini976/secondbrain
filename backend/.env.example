# ==============================================================================
# SECOND BRAIN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or configure in Render Dashboard
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
PORT=8000
API_PREFIX=/api/v1
PROJECT_NAME="Second Brain API"
TESTING=false
ENABLE_DOCS=true

# Database Configuration (PostgreSQL ONLY - SQLite is strictly forbidden)
# Cloud format: postgresql+psycopg://user:password@host:port/database
# Note: 'postgres://' and 'postgresql://' URLs are automatically normalized to 'postgresql+psycopg://'
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/second_brain

# Development Mode Safety Toggle
# Set to 'false' in production on Render to strictly disable all dev mock tokens
DEV_MODE_ENABLED=false
DEV_USER_EMAIL=dev@secondbrain.app
DEV_USER_UID=dev-user-001

# Firebase Authentication (Cloud Deployment)
# Set either individual environment variables or a path to serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=

# CORS Settings (Comma-separated or JSON list of allowed origin URLs)
# Include your Flutter Web URL and allowed origins
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1,http://10.0.2.2
